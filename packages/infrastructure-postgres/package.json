{
  "name": "@lrnki/infrastructure-postgres",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test-support": "./src/testSupport.ts"
  },
  "scripts": {
    "test": "tsx --test src/*.test.ts",
    "test:migrations:db": "tsx --test --test-concurrency=1 src/migrations/applicationSchemaMigration.db.test.ts",
    "db:migrate": "tsx src/migrations/applicationSchemaMigrationCli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lrnki/domain-core": "workspace:*",
    "@lrnki/ports": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
