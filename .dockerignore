# Keep the learner-api build context small and force a clean in-image install.
# node_modules is reinstalled from the frozen lockfile; the rest is never needed at runtime.
# Runtime configuration is injected by Compose. Never bake local credentials into an image; retain
# only the tracked setup template in the build context.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.data
.cache
.local
.venv
node_modules
**/node_modules
tmp
**/tmp
test-results
**/test-results
dist
**/dist
**/dist-e2e
**/dist-realuse
.next
**/.next
.expo
**/.expo
coverage
**/coverage
playwright-report
**/playwright-report
apps/learner-app/android
apps/learner-app/ios
apps/learner-app/lrnki-learner-*.apk
docs
fixtures
.git
# An older shared PostgreSQL container can still bind this retired, host-preserved initializer.
scripts/docker/postgres/01-init-litellm-db.sql
