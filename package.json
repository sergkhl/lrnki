{
  "name": "lrnki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "11.4.0"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @lrnki/admin-lab dev",
    "dev:api": "pnpm --filter @lrnki/learner-api dev",
    "dev:learner": "pnpm --filter @lrnki/learner-app dev",
    "dev:android": "pnpm --filter @lrnki/learner-app android",
    "dev:ios": "pnpm --filter @lrnki/learner-app ios",
    "build": "pnpm --filter @lrnki/admin-lab build && pnpm --filter @lrnki/learner-app export:web",
    "build:android": "scripts/build-learner-android.sh",
    "build:android:dev": "scripts/build-learner-android.sh development",
    "start": "pnpm --filter @lrnki/admin-lab start",
    "lint": "eslint .",
    "test": "pnpm -r --sort --if-present run test",
    "test:db": "scripts/test-db.sh",
    "typecheck": "pnpm -r --sort --if-present run typecheck",
    "check": "pnpm run tmp:clean && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run build && pnpm run e2e:web",
    "e2e:web": "pnpm --filter @lrnki/learner-app e2e",
    "e2e:web:realuse": "pnpm --filter @lrnki/learner-app e2e:realuse",
    "e2e:native:maestro": "pnpm --filter @lrnki/learner-app e2e:native:maestro",
    "tmp:clean": "node scripts/cleanup-tmp.mjs --days 3",
    "db:generate": "scripts/regenerate-initial-migration.sh",
    "db:check": "scripts/check-drizzle-schema.sh",
    "db:migrate": "scripts/migrate-db.sh",
    "seed:demo": "scripts/seed-demo.sh",
    "worker:kg": "pnpm --filter @lrnki/kg-worker worker:kg"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
