{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_LRNKI_E2E_BUILD": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_LRNKI_E2E_BUILD": "0"
      }
    },
    "e2e": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_LRNKI_E2E_BUILD": "1",
        "EXPO_PUBLIC_LEARNER_API_URL": "http://10.0.2.2:8799"
      }
    }
  }
}
